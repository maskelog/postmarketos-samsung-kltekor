+++ b/drivers/media/rc/Kconfig
@@ -202,6 +202,19 @@ config IR_HIX5HD2
 
 	   If you're not sure, select N here
 
+config IR_ICE40_SAMSUNG
+	tristate "Samsung Galaxy S5 iCE40 FPGA IR transmitter"
+	depends on LIRC
+	depends on OF && GPIOLIB && COMMON_CLK
+	select FW_LOADER
+	help
+	  Say Y or M here to use the IR blaster of the Samsung Galaxy S5
+	  (klte). The IR LED is driven by a Lattice iCE40 FPGA which is
+	  configured with a bitstream at probe time.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called ir-ice40-samsung.
+
 config IR_IGORPLUGUSB
 	tristate "IgorPlug-USB IR Receiver"
 	depends on USB
diff --git a/drivers/media/rc/Makefile b/drivers/media/rc/Makefile
index 2bca6f7..596ea78 100644
--- a/drivers/media/rc/Makefile
+++ b/drivers/media/rc/Makefile
@@ -30,6 +30,7 @@ obj-$(CONFIG_IR_FINTEK) += fintek-cir.o
 obj-$(CONFIG_IR_GPIO_CIR) += gpio-ir-recv.o
 obj-$(CONFIG_IR_GPIO_TX) += gpio-ir-tx.o
 obj-$(CONFIG_IR_HIX5HD2) += ir-hix5hd2.o
+obj-$(CONFIG_IR_ICE40_SAMSUNG) += ir-ice40-samsung.o
 obj-$(CONFIG_IR_IGORPLUGUSB) += igorplugusb.o
