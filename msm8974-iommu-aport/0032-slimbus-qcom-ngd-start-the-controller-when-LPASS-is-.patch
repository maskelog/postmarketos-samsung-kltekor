From c53cb9b456de4e8b02fef6c108581d890b4282e8 Mon Sep 17 00:00:00 2001
From: hana <blitzmaske@gmail.com>
Date: Thu, 24 Sep 2026 15:21:43 +0900
Subject: [PATCH 32/35] slimbus: qcom-ngd: start the controller when LPASS is
 already up

QCOM_SSR_AFTER_POWERUP is only emitted when the ADSP boots; if the ADSP
remoteproc is up before this driver probes, the controller never
starts. Use qcom_ssr_last_status() to catch that case and guard against
enabling twice.

From KorelisLabs/lumia-1520-mainline patches/0001.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/slimbus/qcom-ngd-ctrl.c | 42 ++++++++++++++++++++++++++++++++-
 1 file changed, 41 insertions(+), 1 deletion(-)

diff --git a/drivers/slimbus/qcom-ngd-ctrl.c b/drivers/slimbus/qcom-ngd-ctrl.c
index 4fb66986c..6ca48be54 100644
--- a/drivers/slimbus/qcom-ngd-ctrl.c
+++ b/drivers/slimbus/qcom-ngd-ctrl.c
@@ -1372,6 +1372,12 @@ static int qcom_slim_ngd_qmi_new_server(struct qmi_handle *hdl,
 	qmi->svc_info.sq_node = service->node;
 	qmi->svc_info.sq_port = service->port;
 
+	dev_info(ctrl->dev,
+		 "SLIM NGD: QMI service 0x%04x discovered (version %u "
+		 "instance %u) at node %u port %u\n",
+		 SLIMBUS_QMI_SVC_ID, service->version, service->instance,
+		 service->node, service->port);
+
 	complete(&ctrl->qmi_up);
 
 	return 0;
@@ -1460,7 +1466,19 @@ static void qcom_slim_ngd_up_worker(struct work_struct *work)
 	}
 
 	mutex_lock(&ctrl->ssr_lock);
-	qcom_slim_ngd_enable(ctrl, true);
+	/*
+	 * More than one trigger can schedule this worker (PDR UP, SSR
+	 * AFTER_POWERUP, and the late-registration recovery below).
+	 * qcom_slim_ngd_enable(true) calls slim_register_controller(),
+	 * which must not run twice. ctrl->qmi.handle is set by
+	 * qcom_slim_qmi_init() only on full success and cleared by
+	 * qcom_slim_qmi_exit(), so it is an accurate "already enabled"
+	 * flag.
+	 */
+	if (!ctrl->qmi.handle)
+		qcom_slim_ngd_enable(ctrl, true);
+	else
+		dev_info(ctrl->dev, "SLIM NGD: already enabled, skipping\n");
 	mutex_unlock(&ctrl->ssr_lock);
 }
 
@@ -1481,7 +1499,11 @@ static int qcom_slim_ngd_ssr_pdr_notify(struct qcom_slim_ngd_ctrl *ctrl,
 		mutex_unlock(&ctrl->tx_lock);
 		break;
 	case QCOM_SSR_AFTER_POWERUP:
+		dev_info(ctrl->dev, "SLIM NGD: trigger = live SSR AFTER_POWERUP\n");
+		schedule_work(&ctrl->ngd_up_work);
+		break;
 	case SERVREG_SERVICE_STATE_UP:
+		dev_info(ctrl->dev, "SLIM NGD: trigger = PDR avs/audio UP\n");
 		schedule_work(&ctrl->ngd_up_work);
 		break;
 	default:
@@ -1596,6 +1618,24 @@ static int qcom_slim_ngd_probe(struct platform_device *pdev)
 		goto wq_err;
 	}
 
+	/*
+	 * ssr_notify_start() is an rproc subdevice .start callback, so
+	 * QCOM_SSR_AFTER_POWERUP is an event emitted when the remoteproc
+	 * boots, not a state that can be queried by registering late. When
+	 * the ADSP is built in and comes up before this driver probes, no
+	 * AFTER_POWERUP is ever delivered and the controller would stay
+	 * down. qcom_ssr_last_status() exists for exactly this gap
+	 * (drivers/soc/qcom/qcom_sns_reg.c uses the same idiom) and has a
+	 * static-inline stub returning QCOM_SSR_STATUS_UNKNOWN when
+	 * remoteproc support is disabled, so calling it is always safe.
+	 */
+	if (qcom_ssr_last_status("lpass") == QCOM_SSR_AFTER_POWERUP) {
+		dev_info(&pdev->dev,
+			 "SLIM NGD: trigger = late-registration recovery "
+			 "(LPASS already up at probe)\n");
+		schedule_work(&ctrl->ngd_up_work);
+	}
+
 	return 0;
 wq_err:
 	qcom_slim_ngd_qmi_svc_event_deinit(&ctrl->qmi);
-- 
