From 172a0af9dc8daf0129f940ebcd49dc60ac570a6e Mon Sep 17 00:00:00 2001
From: hana <blitzmaske@gmail.com>
Date: Thu, 24 Sep 2026 15:21:43 +0900
Subject: [PATCH 31/35] clk: qcom: spmi-pmic-div: take the output names from
 the device tree

The driver hard-codes div_clk1..3, which the RPM clock controller on
MSM8974 has already registered, so probing fails with -EEXIST. Use
clock-output-names when present.

Taken from the Xperia Z2 (sirius) mainline port
(RobLymm/xperia-sirius-linux, drivers/clk/pmic-clkdiv).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/clk/qcom/clk-spmi-pmic-div.c | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/qcom/clk-spmi-pmic-div.c b/drivers/clk/qcom/clk-spmi-pmic-div.c
index 41a0a4f3b..ee707f00e 100644
--- a/drivers/clk/qcom/clk-spmi-pmic-div.c
+++ b/drivers/clk/qcom/clk-spmi-pmic-div.c
@@ -243,13 +243,26 @@ static int spmi_pmic_clkdiv_probe(struct platform_device *pdev)
 	cxo_hz = clk_get_rate(cxo);
 	clk_put(cxo);
 
-	init.name = name;
 	init.parent_data = &parent_data;
 	init.num_parents = 1;
 	init.ops = &clk_spmi_pmic_div_ops;
 
 	for (i = 0, clkdiv = cc->clks; i < nclks; i++) {
-		snprintf(name, sizeof(name), "div_clk%d", i + 1);
+		const char *of_name;
+
+		/*
+		 * Let the device tree name the outputs. Without this every
+		 * instance registers "div_clk1".."div_clkN", which on msm8974
+		 * collides with the RPM's clocks of the same name and makes
+		 * the whole controller fail to probe with -EEXIST.
+		 */
+		if (!of_property_read_string_index(of_node, "clock-output-names",
+						   i, &of_name)) {
+			init.name = of_name;
+		} else {
+			snprintf(name, sizeof(name), "div_clk%d", i + 1);
+			init.name = name;
+		}
 
 		spin_lock_init(&clkdiv[i].lock);
 		clkdiv[i].base = start + i * 0x100;
-- 
